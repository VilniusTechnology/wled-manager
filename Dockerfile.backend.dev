# Development Dockerfile for WLED Manager Backend API
# This Dockerfile is optimized for development with hot reloading
#
# Build: docker build -f Dockerfile.backend.dev -t wled-manager-backend:dev .
# Run: See docker-compose.dev.yml

FROM python:3.11-slim

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=UTC \
    PYTHONPATH=/app

# Install system dependencies
# - tzdata: Timezone support
# - curl: Health checks and debugging
# - ca-certificates: SSL/TLS support
# - gcc: For compiling some Python packages
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    tzdata \
    curl \
    ca-certificates \
    gcc \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Optional: Install development tools
# Uncomment these for development helpers
RUN pip install --no-cache-dir \
    ipython \
    pytest \
    pytest-cov

# Create necessary directories
RUN mkdir -p /app/backups /app/database /app/db

# In development, we typically run as root for easier debugging
# For production, you should create and use a non-root user

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default command (will be overridden in docker-compose.dev.yml)
CMD ["uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
