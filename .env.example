# WLED Manager Environment Configuration Template
# Copy this file to .env and update with your settings
#
# cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!

# Domain name for Ingress (default: wled-manager.home)
DOMAIN_NAME=wled-manager.home

# ============================================================================
# Timezone
# ============================================================================

# System timezone (default: UTC)
# Examples: America/New_York, Europe/London, Asia/Tokyo
TIMEZONE=UTC

# ============================================================================
# Security
# ============================================================================

# Secret key for encryption (REQUIRED)
# Generate a random string (e.g., `openssl rand -hex 32`)
SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# ============================================================================
# Docker Registry
# ============================================================================

# Docker registry for production images (default: localhost)
# Examples: docker.io/username, ghcr.io/organization, registry.example.com
REGISTRY=localhost
REGISTRY_USERNAME=yourusername

# Repository Names
API_REPO=wled-manager-backend
UI_REPO=wled-manager-frontend

# ============================================================================
# Backend Configuration
# ============================================================================

# Debug mode (true/false)
DEBUG=true

# Log level (debug, info, warning, error, critical)
LOG_LEVEL=info

# Backend host (usually 0.0.0.0 to allow external connections)
BACKEND_HOST=0.0.0.0

# Backend port
BACKEND_PORT=8000

# ============================================================================
# Frontend Configuration
# ============================================================================

# API URL for frontend (used by Vite)
# Development (default - uses Docker service name):
VITE_API_HOST=backend
VITE_API_PORT=8000
VITE_API_PROTOCOL=http

# Production (use actual domain):
# VITE_API_HOST=api.example.com
# VITE_API_PORT=443
# VITE_API_PROTOCOL=https

# ============================================================================
# Data Storage
# ============================================================================

# Backup directory (relative to project root)
BACKUP_DIR=/app/backups

# Host Data Path for K8s Persistence (default: /mnt/data/wled-manager)
DATA_PATH=/mnt/data/wled-manager

# Database path
DATABASE_PATH=/app/database

# ============================================================================
# Network Scanning Configuration
# ============================================================================

# Network range to scan (CIDR notation)
# Examples: 192.168.1.0/24, 10.0.0.0/16
NETWORK_RANGE=192.168.1.0/24

# NOTE: Other scanning, backup, device refresh, and WLED timeout settings
# are configured via the Settings UI and stored in the database.

# ============================================================================
# Advanced Settings
# ============================================================================

# Python environment
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Node environment
NODE_ENV=development

# Workers for production backend (Uvicorn)
BACKEND_WORKERS=4

# CORS allowed origins (comma-separated)
# Development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Production:
# CORS_ORIGINS=https://example.com,https://www.example.com
